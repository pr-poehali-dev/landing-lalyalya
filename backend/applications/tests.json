{
  "tests": [
    {
      "name": "Create application",
      "method": "POST",
      "path": "/",
      "body": {
        "first_name": "Иван",
        "last_name": "Петров",
        "phone": "+79001234567",
        "email": "ivan@example.com",
        "consent": true,
        "photo_consent": true
      },
      "expectedStatus": 200,
      "expectedBody": {"success": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "Reject without consent",
      "method": "POST",
      "path": "/",
      "body": {
        "first_name": "Иван",
        "last_name": "Петров",
        "phone": "+79001234567",
        "email": "ivan@example.com",
        "consent": false
      },
      "expectedStatus": 400
    },
    {
      "name": "Reject admin list without password",
      "method": "GET",
      "path": "/",
      "expectedStatus": 401
    },
    {
      "name": "Reject edit without password",
      "method": "PUT",
      "path": "/",
      "body": {"id": 1, "first_name": "A", "last_name": "B", "phone": "1", "email": "a@b.ru"},
      "expectedStatus": 401
    },
    {
      "name": "Reject delete without password",
      "method": "DELETE",
      "path": "/?id=1",
      "expectedStatus": 401
    }
  ]
}